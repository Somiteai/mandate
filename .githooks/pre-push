#!/bin/bash
# Blocks pushes that update origin/main. Allows branch deletes and other refs.

protected_ref="refs/heads/main"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "$protected_ref" ]; then
    echo "ERROR: Direct push to 'main' is not allowed."
    echo "Use a ship/<name> or capture/<name> branch and open a PR."
    exit 1
  fi
done

exit 0
